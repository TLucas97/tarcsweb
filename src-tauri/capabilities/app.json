{
  "identifier": "app",
  "windows": ["main"],
  "local": false,
  "remote": { "urls": [] },
  "permissions": [
    "allow-read-clipboard-image", "allow-notify-session", "allow-desktop-update", "process:allow-restart",
    "core:default", "core:window:allow-close", "allow-shell-info", "allow-apply-open-mode", "allow-open-external",
    "notification:allow-is-permission-granted", "notification:allow-request-permission", "notification:allow-notify",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }] }
  ]
}
