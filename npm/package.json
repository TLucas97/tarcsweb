  "keywords": ["claude-code", "codex", "web-ui", "agents"],
  "license": "MIT",
  "homepage": "https://github.com/TLucas97/tarcsweb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TLucas97/tarcsweb.git",
    "directory": "npm"
  },
  "type": "module",
  "bin": {
    "tarcsweb": "bin/tarcsweb.js"
